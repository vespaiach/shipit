#!/usr/bin/env bash
# libexec/run <app> <process> (plan §3): the process launcher. <app>@.service runs it as the app user,
# in /opt/<app>/current. It reads PROCESS_<process> from the release's deploy.conf (or the zero-config
# default) and execs it, so the app becomes the unit's main process and gets SIGTERM directly.
# Exit 78 means "not defined in this release": the unit's RestartPreventExitStatus=78 stops the loop.

# shellcheck source=lib/common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

EX_CONFIG=78

launch() {
  local app=${1-} process=${2-} dir var
  if ! check_app_name "$app" || ! check_process_name "$process"; then
    exit "$EX_CONFIG"
  fi
  if [ -z "${PORT-}" ]; then
    err "PORT isn't set. Start $app through its unit: systemctl start $app.target"
    exit "$EX_CONFIG"
  fi
  dir=$SHIPIT_OPT/$app/current
  cd "$dir" || exit 1
  # The single PATH for node: the hook for per-app Node later.
  export PATH=$dir/node_modules/.bin:/usr/bin:/bin
  if [ -f deploy.conf ]; then
    # shellcheck source=/dev/null
    . ./deploy.conf
  else
    # shellcheck disable=SC2034 # read through ${!var} below
    PROCESS_web="next start --hostname 127.0.0.1 --port $PORT"
  fi
  var=PROCESS_$process
  if [ -z "${!var-}" ]; then
    err "$process isn't defined in this release"
    exit "$EX_CONFIG"
  fi
  exec bash -c "exec ${!var}"
}

# Run only when executed; the unit tests source this file and call launch.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  launch "$@"
fi
