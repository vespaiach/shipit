# managed by shipit: the systemd unit of the site ${SITE}. shipit deploy and rollback write it from the
# shipit.ini of the release ${SRV_ROOT}/${SITE}/current points at; edits here are lost.
[Unit]
Description=shipit site ${SITE}
After=network.target

[Install]
WantedBy=multi-user.target

[Service]
User=${SITE}
Group=${SITE}
WorkingDirectory=${SRV_ROOT}/${SITE}/current
# The site's secrets, read by systemd as root. A site that has none needs no file.
EnvironmentFile=-${SHIPIT_ETC}/sites/${SITE}.env
Environment=NODE_ENV=production PORT=${PORT}
ExecStart=/bin/sh -c '${START}'
Restart=on-failure
# Output goes to the journal: journalctl -u shipit-${SITE}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The site may listen on its own port only, so it can't take another site's while that one restarts.
SocketBindAllow=tcp:${PORT}
SocketBindDeny=any
