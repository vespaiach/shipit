
# ${DOMAIN} serves the folder ${ROOT} of the current release.
${DOMAIN} {
	import shipit-${SITE}-log
	root * ${SRV_ROOT}/${SITE}/current/${ROOT}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	file_server
}
