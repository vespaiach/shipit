# managed by shipit: the Caddy file of the site ${SITE}. shipit deploy and rollback write it from the
# shipit.ini of the release ${SRV_ROOT}/${SITE}/current points at; edits here are lost.

# The site's access log, shared by its own block and its alias redirects.
(shipit-${SITE}-log) {
	log {
		output file ${LOG_ROOT}/${SITE}/access.log {
			roll_size 10MiB
			roll_keep 10
		}
		# Query strings can carry tokens, so they're cut from the logged URI, and from the Referer and
		# Location headers, which can repeat them.
		format filter {
			request>uri regexp \?.*$ ""
			request>headers>Referer regexp \?.*$ ""
			resp_headers>Location regexp \?.*$ ""
		}
	}
}
