#!/usr/bin/env bash
# shipit: set up a Debian 13 VPS for Next.js apps, and deploy them from GitHub. See `shipit help`.
set -euo pipefail

# Installed as /usr/local/lib/shipit/bin/shipit (linked from /usr/local/bin), or run from a checkout.
SHIPIT_LIB=$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)

usage() {
  cat <<'EOF'
Usage: sudo shipit <command> [arguments]

  setup                              Prepare this VPS once (safe to re-run)
  deploy <github-url | app> [--ref <sha>]
                                     Deploy a new app, or redeploy an existing one
  rollback <app>                     Switch back to the previous release
  status [app]                       Show releases, processes, health and backups
  logs <app> [process | access | deploy]
                                     Follow an app's log files
  env <app>                          Edit an app's environment file
  backup <app>                       Take a database backup now
  restore <app> [file | latest]      Restore a database backup
  help                               Show this help
EOF
}

# Runs lib/<command>.sh's cmd_<command> once a milestone adds it.
run_command() {
  local cmd=$1
  shift
  # shellcheck source=lib/common.sh
  . "$SHIPIT_LIB/common.sh"
  [ -f "$SHIPIT_LIB/$cmd.sh" ] || die "shipit $cmd is not implemented yet."
  # shellcheck source=/dev/null
  . "$SHIPIT_LIB/$cmd.sh"
  "cmd_$cmd" "$@"
}

main() {
  local cmd=${1-}
  case "$cmd" in
    help | -h | --help)
      usage
      return 0
      ;;
    '')
      usage >&2
      return 1
      ;;
    setup | deploy | rollback | status | logs | env | backup | restore) ;;
    *)
      printf "Unknown command: %s. Run 'shipit help' for the list.\n" "$cmd" >&2
      return 1
      ;;
  esac
  if [ "$(id -u)" -ne 0 ]; then
    printf 'Run this as root, or with sudo: sudo shipit %s\n' "$*" >&2
    return 1
  fi
  shift
  run_command "$cmd" "$@"
}

main "$@"
