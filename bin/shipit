#!/usr/bin/env bash
# shipit: set up a Debian or Ubuntu VPS, and deploy websites onto it from GitHub. See `shipit help`.
set -euo pipefail

# Installed as /usr/local/lib/shipit/bin/shipit (linked from /usr/local/bin), or run from a checkout.
SHIPIT_LIB=$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)

usage() {
  cat <<'EOF'
Usage: sudo shipit <command> [arguments]

  setup                              Prepare this VPS (safe to re-run)
  deploy <name> [ref]                Build a site from GitHub and switch to it
  deploy <repo-url> <name> [ref]     The same, for a site's first deploy
  rollback <name>                    Go back to the previous release
  delete <name>                      Delete a site and its data (asks first)
  help                               Show this help
EOF
}

main() {
  local cmd=${1-}
  case "$cmd" in
    help | -h | --help)
      usage
      return 0
      ;;
    '')
      usage >&2
      return 1
      ;;
    setup | deploy | rollback | delete) ;;
    *)
      printf "Unknown command: %s. Run 'shipit help' for the list.\n" "$cmd" >&2
      return 1
      ;;
  esac
  if [ "$(id -u)" -ne 0 ]; then
    printf 'Run this as root, or with sudo: sudo shipit %s\n' "$*" >&2
    return 1
  fi
  shift
  # shellcheck source=lib/common.sh
  . "$SHIPIT_LIB/common.sh"
  # shellcheck source=/dev/null
  . "$SHIPIT_LIB/$cmd.sh"
  "cmd_$cmd" "$@"
}

main "$@"
