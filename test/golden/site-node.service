# managed by shipit: the systemd unit of the site blog. shipit deploy writes it from the site's
# shipit.ini (/srv/blog/config/shipit.ini); edits here are lost.
[Unit]
Description=shipit site blog
After=network.target

[Install]
WantedBy=multi-user.target

[Service]
User=blog
Group=blog
WorkingDirectory=/srv/blog/current
# The site's secrets, read by systemd as root. A site that has none needs no file.
EnvironmentFile=-/etc/shipit/sites/blog.env
Environment=NODE_ENV=production PORT=3000
ExecStart=/bin/sh -c 'node server.js'
Restart=on-failure
# Output goes to the journal: journalctl -u shipit-blog
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The site may listen on its own port only, so it can't take another site's while that one restarts.
SocketBindAllow=tcp:3000
SocketBindDeny=any
