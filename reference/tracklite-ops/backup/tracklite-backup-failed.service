[Unit]
Description=Email the owner that the Tracklite backup failed (OPS-003.3)

[Service]
Type=oneshot
DynamicUser=true
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/tracklite/env
EnvironmentFile=/etc/tracklite/backup.env
ExecStart=/usr/local/lib/tracklite-backup/notify-failure.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
