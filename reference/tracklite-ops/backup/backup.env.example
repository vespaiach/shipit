# Template for /etc/tracklite/backup.env (root:root, mode 600). Never commit real values (OPS-006).
# Read by tracklite-backup.service and tracklite-backup-failed.service.

# Who gets the failure email (OPS-003.3).
OWNER_EMAIL=

# Public key from `age-keygen` (age1...). The private key stays off the VPS.
AGE_RECIPIENT=

# Cloudflare R2: a bucket and an API token with Object Read & Write on that bucket only.
R2_BUCKET=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
