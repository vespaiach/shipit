[Unit]
Description=Tracklite database backup to R2 (OPS-003)
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=tracklite-backup-failed.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/tracklite/backup.env
ExecStart=/usr/local/lib/tracklite-backup/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
